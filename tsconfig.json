{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// worker-configuration.d.ts derlenmiş Worker'ı içe aktarır; derleme çıktısındaki JS denetlenmesin.
		// Elle yazılan JS dosyaları `// @ts-check` ile tek tek denetleniyor.
		"checkJs": false,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"]
	},
	"include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
