{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "atolye",
	"compatibility_date": "2026-10-04",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "isrky",
			"database_id": "f5c8c821-be49-41dc-8087-923334a150a1",
			"migrations_dir": "migrations"
		}
	],
	// Gizli değerlerin adları burada bildirilir: türler .dev.vars olmadan da (CI'da) aynı üretilir
	// ve `wrangler deploy` eksik gizli değerle yayına almayı reddeder.
	"secrets": {
		"required": ["TUZ"]
	},
	"workers_dev": true,
	"preview_urls": true
}
